# docker compose 会自动读取与本文件同名的 .env（复制一份再填）。
# 这里只放密钥与部署相关变量，它们优先于 data/config.yaml。
# 全部留空 = 使用 config.yaml 的配置（SQLite + 开发者模式邮箱）。

# ---- 数据库 ----
# 容器内连宿主机 MySQL：
#   DATABASE_URL=mysql+pymysql://chronosfit:你的密码@host.docker.internal:3306/chronosfit?charset=utf8mb4
# 连 compose 自带的 mysql 服务（需 --profile mysql）：
#   DATABASE_URL=mysql+pymysql://chronosfit:chronosfit@mysql:3306/chronosfit?charset=utf8mb4
DATABASE_URL=

# ---- 导出接口密钥（留空 = 不校验）----
CHRONOSFIT_API_KEY=

# ---- 邮箱服务器：三项都填了才真实发信，否则走开发者模式 ----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- 仅 --profile mysql 时使用；不改则用 docker-compose.yml 里的开发默认值 ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
